# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Exclude sourcemaps
*.map

# TypeScript incremental build state
*.tsbuildinfo

# obsidian
data.json
.DS_Store
dist
.hotreload
coverage
yarn-error.log

# Python cache
scripts/__pycache__/
